@EPUB_END@

class ReaderRemember : public testing::TestWithParam<const char*> {
 protected:
  void SetUp() override {
    APP_STATE = {}; RECENT_BOOKS = {}; Storage.present = true; SETTINGS.font = 1; failAllocation = false;
    activityManager = {}; GUI = {}; mappedInput = {};
  }
};

TEST(ReaderFontGate, MissingEpubAndTxtFontsOfferBackToHome) {
  for (const char* path : {"book.epub", "book.txt"}) {
    ReaderActivity reader;
    reader.bookPath = path;
    SETTINGS.font = 0;
    activityManager = {};
    reader.onEnter();
    EXPECT_TRUE(activityManager.messageShown) << path;
    EXPECT_TRUE(activityManager.backToHomeEnabled) << path;
    EXPECT_FALSE(reader.finished) << path;
  }
}

TEST(FullScreenMessage, BackHintAndHomeActionAreOptIn) {
  GfxRenderer renderer;
  FullScreenMessageActivity defaultMessage(renderer, mappedInput, "SD card error", false);
  defaultMessage.onEnter();
  mappedInput.backReleased = true;
  defaultMessage.loop();
  EXPECT_EQ(GUI.hintDraws, 0);
  EXPECT_EQ(activityManager.homeCalls, 0);

  GUI = {};
  activityManager = {};
  FullScreenMessageActivity fontMessage(renderer, mappedInput, "No fonts available", true);
  fontMessage.onEnter();
  EXPECT_EQ(GUI.hintDraws, 1);
  EXPECT_EQ(GUI.firstHint, "Back");
  fontMessage.loop();
  EXPECT_EQ(activityManager.homeCalls, 1);
}
TEST_P(ReaderRemember, NewAndExistingArePromotedOnlyAfterUsableRender) {
  for (bool existing : {false, true}) {
    ReaderActivity reader;
    reader.bookPath = GetParam();
    RECENT_BOOKS.paths = existing ? std::vector<std::string>{"other", GetParam()} : std::vector<std::string>{"other"};
    const auto before = RECENT_BOOKS.paths;
    reader.onEnter();
    reader.rememberBookOnceRendered();
    EXPECT_EQ(RECENT_BOOKS.paths, before);
    EXPECT_TRUE(APP_STATE.openEpubPath.empty());
    reader.markPageRendered();
    reader.rememberBookOnceRendered();
    EXPECT_EQ(RECENT_BOOKS.paths.front(), GetParam());
    EXPECT_EQ(std::count(RECENT_BOOKS.paths.begin(), RECENT_BOOKS.paths.end(), GetParam()), 1);
    EXPECT_EQ(APP_STATE.openEpubPath, GetParam());
    const auto saves = APP_STATE.saves;
    reader.rememberBookOnceRendered();
    EXPECT_EQ(APP_STATE.saves, saves);
    EXPECT_EQ(reader.progressWrites, 0);
  }
}
TEST_P(ReaderRemember, MissingInvalidAndCancelledAttemptsPreserveExistingRecents) {
  for (int failure : {0, 1, 2}) {
    for (bool existing : {false, true}) {
    ReaderActivity reader;
    reader.bookPath = GetParam();
    APP_STATE = {};
    RECENT_BOOKS.paths = existing ? std::vector<std::string>{"other", GetParam()} : std::vector<std::string>{"other"};
    const auto before = RECENT_BOOKS.paths;
    Storage.present = failure != 0;
    reader.loadSucceeds = failure != 1;
    reader.onEnter();
    // Cancellation before the render task completes also has no success publication.
    reader.rememberBookOnceRendered();
    EXPECT_EQ(RECENT_BOOKS.paths, before);
    EXPECT_TRUE(APP_STATE.openEpubPath.empty());
    EXPECT_EQ(reader.progressWrites, 0);
    }
  }
}
INSTANTIATE_TEST_SUITE_P(Formats, ReaderRemember, testing::Values("book.epub", "book.xtc", "book.txt"));

TEST(ReaderSuccessBoundary, TxtFailureDoesNotPublishOrOverwriteByteCheckpoint) {
  APP_STATE = {}; RECENT_BOOKS = {};
  TxtReaderActivity reader;
  reader.bookPath = "book.txt";
  reader.pageReader.succeeds = false;
  reader.renderBook();
  reader.rememberBookOnceRendered();
  EXPECT_TRUE(RECENT_BOOKS.paths.empty());
  EXPECT_EQ(reader.progressWrites, 0);
  reader.pageReader.succeeds = true;
  reader.pageReader.advances = false;
  reader.renderBook();
  EXPECT_FALSE(reader.pageRendered.load());
  reader.pageReader.advances = true;
  reader.renderBook();
  reader.rememberBookOnceRendered();
  EXPECT_EQ(RECENT_BOOKS.paths.front(), "book.txt");
  EXPECT_EQ(reader.savedAnchor, 123u);
}
TEST(ReaderSuccessBoundary, ValidEmptyTxtIsAUsableView) {
  TxtReaderActivity reader;
  reader.txt->bytes = 0;
  reader.renderBook();
  EXPECT_TRUE(reader.pageRendered.load());
  EXPECT_EQ(reader.renderer.displays, 1);
}
TEST(ReaderSuccessBoundary, XtcReadAndAllocationFailuresDoNotPublish) {
  XtcReaderActivity reader;
  reader.xtc->readSucceeds = false;
  reader.renderPage();
  EXPECT_FALSE(reader.pageRendered.load());
  reader.xtc->readSucceeds = true;
  failAllocation = true;
  reader.renderPage();
  EXPECT_FALSE(reader.pageRendered.load());
  failAllocation = false;
  for (int depth : {1, 2}) {
    reader.pageRendered = false;
    reader.xtc->depth = depth;
    reader.renderPage();
    EXPECT_TRUE(reader.pageRendered.load());
  }
}
TEST(ReaderSuccessBoundary, EpubContentAndValidEndViewPublishButEmptySpineDoesNot) {
  EpubReaderActivity reader;
  reader.endOfBookOptions = std::make_unique<int>(1);
  reader.epub->count = 0;
  reader.onEndOfBookRendered();
  EXPECT_FALSE(reader.pageRendered.load());
  reader.epub->count = 3;
  reader.onEndOfBookRendered();
  EXPECT_TRUE(reader.pageRendered.load());
  reader.pageRendered = false;
  reader.completeContentRender();
  EXPECT_TRUE(reader.pageRendered.load());
}

TEST(ReaderSuccessBoundary, EpubExistingByteAnchorAndPageProgressRemainUnchangedByRemembering) {
  EpubReaderActivity reader;
  Storage.bytes = {1, 0, 12, 0, 30, 0, 0x34, 0x12, 0, 0};
  reader.restoreProgress();
  ASSERT_EQ(reader.cachedVisibleTextOffset, 0x1234u);
  EXPECT_EQ(reader.currentSpineIndex, 1);
  EXPECT_EQ(reader.nextPageNumber, 12);
  EXPECT_EQ(reader.cachedChapterTotalPageCount, 30);
  reader.completeContentRender();
  reader.rememberBookOnceRendered();
  EXPECT_EQ(reader.cachedVisibleTextOffset, 0x1234u);
  EXPECT_EQ(reader.nextPageNumber, 12);
}
TEST(ReaderSuccessBoundary, XtcExistingProgressRestoresBeforeRemembering) {
  XtcReaderActivity reader;
  Storage.bytes = {1, 0, 0, 0};
  reader.currentPage = 0;
  reader.loadProgress();
  ASSERT_EQ(reader.currentPage, 1u);
  reader.renderPage();
  reader.rememberBookOnceRendered();
  EXPECT_EQ(reader.currentPage, 1u);
}
TEST(ReaderSuccessBoundary, RenderTaskPublishesSuccessAndMainRemembersOnce) {
  ReaderActivity reader;
  RECENT_BOOKS = {};
  std::thread rendering([&] { reader.markPageRendered(); });
  while (!reader.pageRendered.load(std::memory_order_acquire)) std::this_thread::yield();
  reader.rememberBookOnceRendered();
  rendering.join();
  reader.rememberBookOnceRendered();
  ASSERT_EQ(RECENT_BOOKS.paths.size(), 1u);
}
TEST(ReaderSuccessBoundary, ExitFlushesCompletedRenderWithoutPromotingUnrenderedAttempt) {
  APP_STATE = {}; RECENT_BOOKS = {};
  ReaderActivity failed;
  failed.onExit();
  EXPECT_TRUE(RECENT_BOOKS.paths.empty());
  ReaderActivity rendered;
  rendered.markPageRendered();
  rendered.onExit();
  ASSERT_EQ(RECENT_BOOKS.paths.size(), 1u);
  EXPECT_EQ(APP_STATE.openEpubPath, rendered.bookPath);
  EXPECT_EQ(rendered.progressWrites, 0);
}
