constexpr int UI_10_FONT_ID = 0, UI_12_FONT_ID = 0, STR_BACK = 0, STR_EMPTY_FILE = 0, STR_NO_FONTS_AVAILABLE = 0,
              STR_MEMORY_ERROR = 0, STR_PAGE_LOAD_ERROR = 0, STR_INDEXING = 0, STR_SAVE_PROGRESS_FAILED = 0;
const char* tr(int key) { return key == STR_BACK ? "Back" : "message"; }
unsigned long millis() { return 1; }
struct EpdFontFamily { using Style = int; enum { BOLD, REGULAR }; };
struct HalDisplay { using RefreshMode = int; enum GrayscaleBase { Combined, Separate }; enum { HALF_REFRESH, FAST_REFRESH }; };
struct MappedInputManager {
  enum class Button { Back };
  struct Labels { const char* btn1; const char* btn2; const char* btn3; const char* btn4; };
  bool backReleased = false;
  bool wasReleased(Button) const { return backReleased; }
  Labels mapLabels(const char* btn1, const char* btn2, const char* btn3, const char* btn4) const {
    return {btn1, btn2, btn3, btn4};
  }
} mappedInput;
struct GfxRenderer {
  enum class Orientation { Portrait };
  struct FontCache { void releaseSdFontCaches() {} } fontCache;
  FontCache* getFontCacheManager() { return &fontCache; }
  void setOrientation(Orientation) {}
  int displays = 0;
  struct Caps { HalDisplay::GrayscaleBase base = HalDisplay::Separate; };
  Caps grayscaleCapabilities() const { return {}; }
  int getLineHeight(int) const { return 20; }
  int getScreenHeight() const { return 800; }
  void clearScreen(int = 0) {}
  void drawCenteredText(int, int, const char*, bool, int) {}
  void drawPixel(int, int, bool) {}
  void displayBuffer(int = 0) { ++displays; }
  void displayGrayscaleBase(int) { ++displays; }
  void preconditionGrayscale() {}
  void copyGrayscaleLsbBuffers() {}
  void copyGrayscaleMsbBuffers() {}
  void displayGrayBuffer() { ++displays; }
  void cleanupGrayscaleWithFrameBuffer() {}
};
namespace ReaderUtils {
void displayWithRefreshCycle(GfxRenderer& r, int&) { r.displayBuffer(); }
}
struct CrossPointSettings {
  enum XTC_STATUS_BAR_MODE { XTC_STATUS_BAR_TOP, XTC_STATUS_BAR_BOTTOM };
  int font = 1;
  int getReaderFontId() const { return font; }
  int getRefreshFrequency() const { return 4; }
  struct Status { int xtcMode = XTC_STATUS_BAR_BOTTOM; };
  Status statusBarSpec() const { return {}; }
} SETTINGS;
struct HalFile {
  std::vector<uint8_t> bytes;
  int read(void* dst, size_t n) { n = std::min(n, bytes.size()); std::memcpy(dst, bytes.data(), n); return n; }
};
struct {
  bool present = true;
  std::vector<uint8_t> bytes;
  bool exists(const char*) { return present; }
  bool openFileForRead(const char*, const std::string&, HalFile& f) { f.bytes = bytes; return !bytes.empty(); }
} Storage;
[[maybe_unused]] struct { size_t getFreeHeap() { return 100000; } size_t getMaxAllocHeap() { return 100000; } } ESP;
struct { void ensureLoaded(GfxRenderer&) {} } sdFontSystem;
struct {
  bool messageShown = false;
  bool backToHomeEnabled = false;
  int homeCalls = 0;
  void goToFullScreenMessage(const char*, int, bool allowBackToHome) {
    messageShown = true;
    backToHomeEnabled = allowBackToHome;
  }
  void goHome() { ++homeCalls; }
} activityManager;
struct {
  int hintDraws = 0;
  std::string firstHint;
  void drawPopup(GfxRenderer&, const char*) {}
  void drawButtonHints(GfxRenderer&, const char* btn1, const char*, const char*, const char*) {
    ++hintDraws;
    firstHint = btn1;
  }
} GUI;
struct FsHelpers { static bool hasXtcExtension(const std::string& p) { return p.ends_with(".xtc"); } };
struct ScreenshotUtil { static void takeScreenshot(GfxRenderer&) {} };
struct State {
  int readerActivityLoadCount = 0;
  std::string openEpubPath;
  int saves = 0;
  void saveToFile() { ++saves; }
} APP_STATE;
struct Recents {
  std::vector<std::string> paths;
  void addBook(const std::string& path, const std::string&, const std::string&, const std::string&) {
    auto it = std::find(paths.begin(), paths.end(), path);
    if (it != paths.end()) paths.erase(it);
    paths.insert(paths.begin(), path);
  }
} RECENT_BOOKS;
struct Activity { void onEnter() {} void onExit() {} };
class ReaderActivity : public Activity {
 public:
  GfxRenderer renderer;
  std::string bookPath = "book.epub";
  bool loadSucceeds = true, finished = false;
  int updates = 0, progressWrites = 0;
  std::unique_ptr<int> endOfBookOptions;
  std::atomic<bool> endOfBookOptionsReady{false};
  @REMEMBER_STATE@
  virtual bool loadBook() { return loadSucceeds; }
  std::string getBookTitle() const { return "한글 제목"; }
  std::string getBookAuthor() const { return "저자"; }
  std::string getBookThumbBmpPath() const { return "cover.bmp"; }
  void finish() { finished = true; }
  void requestUpdate() { ++updates; }
  void applyInitialOrientation() {}
  void onEnter();
  void onExit();
};
class FullScreenMessageActivity : public Activity {
 public:
  GfxRenderer& renderer;
  MappedInputManager& mappedInput;
  std::string text;
  EpdFontFamily::Style style = EpdFontFamily::REGULAR;
  HalDisplay::RefreshMode refreshMode = HalDisplay::FAST_REFRESH;
  bool allowBackToHome = false;
  FullScreenMessageActivity(GfxRenderer& renderer, MappedInputManager& mappedInput, std::string text, bool allowBack)
      : renderer(renderer), mappedInput(mappedInput), text(std::move(text)), allowBackToHome(allowBack) {}
  void onEnter();
  void loop();
};
@FULLSCREEN_ENTER@
@FULLSCREEN_LOOP@
@ENTER@
@EXIT@

struct Txt {
  size_t bytes = 500;
  size_t getFileSize() const { return bytes; }
};
class TxtReaderActivity : public ReaderActivity {
 public:
  std::unique_ptr<Txt> txt = std::make_unique<Txt>();
  bool initialized = true, pendingInitialIndexingPopup = false, currentPageLoaded = false,
       hasCurrentDisplayOrdinal = false, cachedHyphenationEnabled = false, pendingScreenshot = false;
  size_t currentPageEndOffset = 0, currentDisplayOrdinal = 0, savedAnchor = 0;
  int cachedFontId = 1, viewportWidth = 100, linesPerPage = 5;
  std::vector<std::string> currentPageLines;
  struct History { size_t offset = 123; size_t currentOffset() { return offset; } } pageHistory;
  struct Estimate { void observePage(size_t, size_t) {} size_t pageNumberAt(size_t) { return 4; } } pageEstimate;
  struct PageReader {
    bool succeeds = true, advances = true;
    bool loadPage(Txt&, GfxRenderer&, int, int, int, size_t offset, std::vector<std::string>&, size_t& end, bool) {
      end = offset + (advances ? 20 : 0);
      return succeeds;
    }
  } pageReader;
  void initializeReader(GfxRenderer&) { initialized = true; }
  void updateLayoutIfChanged(GfxRenderer&) {}
  void renderPage(GfxRenderer& r) { r.displayBuffer(); }
  void persistVisibleCheckpoint() { ++progressWrites; savedAnchor = pageHistory.currentOffset(); }
  void renderBook();
};
@TXT_RENDER@

namespace xtc { const char* errorToString(int) { return "read failure"; } }
struct Xtc {
  int depth = 1;
  bool readSucceeds = true;
  uint16_t getPageWidth() { return 2; }
  uint16_t getPageHeight() { return 2; }
  uint8_t getBitDepth() { return depth; }
  unsigned getPageCount() { return 3; }
  std::string getCachePath() { return "cache"; }
  int getLastError() { return 0; }
  size_t loadPage(unsigned, uint8_t* p, size_t size) { std::memset(p, 0xff, size); return readSucceeds ? size : 0; }
};
bool failAllocation = false;
void* testMalloc(size_t size) { return failAllocation ? nullptr : std::malloc(size); }
class XtcReaderActivity : public ReaderActivity {
 public:
  std::unique_ptr<Xtc> xtc = std::make_unique<Xtc>();
  int pagesUntilFullRefresh = 3;
  unsigned currentPage = 1;
  enum StatusBarOverlayPosition { Top, Bottom };
  void renderStatusBarOverlay(GfxRenderer&, StatusBarOverlayPosition) {}
  void renderPage();
  void loadProgress();
};
#define malloc testMalloc
@XTC_RENDER@
#undef malloc
@XTC_PROGRESS@

