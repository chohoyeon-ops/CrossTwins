class String : public std::string {
 public:
  using std::string::string;
  String(const std::string& s) : std::string(s) {}
  bool isEmpty() const { return empty(); }
  size_t length() const { return size(); }
  bool startsWith(const char* s) const { return starts_with(s); }
  bool endsWith(const char* s) const { return ends_with(s); }
  bool equals(const char* s) const { return *this == s; }
  int indexOf(char c, int pos = 0) const { auto n = find(c, pos); return n == npos ? -1 : static_cast<int>(n); }
  int indexOf(const char* c) const { auto n = find(c); return n == npos ? -1 : static_cast<int>(n); }
  int lastIndexOf(char c) const { auto n = rfind(c); return n == npos ? -1 : static_cast<int>(n); }
  String substring(int first, int last = -1) const { return substr(first, last < 0 ? npos : last - first); }
  char charAt(size_t n) const { return (*this)[n]; }
  void trim() { while (!empty() && std::isspace(static_cast<unsigned char>(back()))) pop_back();
    while (!empty() && std::isspace(static_cast<unsigned char>(front()))) erase(0, 1); }
};
namespace FsHelpers {
@COMPONENT@
bool isSafePathComponent(const String& s) { return isSafePathComponent(std::string_view(s.data(), s.size())); }
}
constexpr const char* HIDDEN_ITEMS[] = {"System Volume Information", "XTCache"};
struct HalFile {
  bool opened = false, dir = false;
  std::string path;
  explicit operator bool() const { return opened; }
  bool isDirectory() const { return dir; }
  void close() { opened = false; }
  HalFile openNextFile() { return {}; }
  bool rename(const char*);
  size_t write(const void*, size_t n);
};
struct StorageStub {
  std::map<std::string, bool> entries;
  std::vector<std::string> mutations;
  std::vector<std::string> reads;
  bool exists(const char* p) const { return entries.contains(p); }
  HalFile open(const char* p) { reads.push_back(p); return {exists(p), entries[p], p}; }
  bool openFileForWrite(const char*, const String& p, HalFile& f) {
    mutations.push_back("write:" + p); entries[p] = false; f = {true, false, p}; return true;
  }
  bool mkdir(const char* p) { mutations.push_back("mkdir:" + std::string(p)); entries[p] = true; return true; }
  bool remove(const char* p) { mutations.push_back("remove:" + std::string(p)); entries.erase(p); return true; }
  bool rmdir(const char* p) { return remove(p); }
} Storage;
bool HalFile::rename(const char* p) { Storage.mutations.push_back("rename:" + std::string(p));
  Storage.entries.erase(path); Storage.entries[p] = dir; return true; }
size_t HalFile::write(const void*, size_t n) { Storage.mutations.push_back("data:" + path); return n; }
struct HTTPUpload { String filename; };
struct WebServer {
  std::map<std::string, String> args;
  String requestUri, destination;
  int status = 0;
  HTTPUpload incoming;
  bool hasArg(const char* key) const { return args.contains(key); }
  String arg(const char* key) { return args[key]; }
  HTTPUpload& upload() { return incoming; }
  String uri() const { return requestUri; }
  String header(const char*) const { return destination; }
  template<class... Args> void send(int code, Args&&...) { status = code; }
  static String urlDecode(const String& input) {
    String out;
    for (size_t i = 0; i < input.size(); ++i) {
      if (input[i] == '%' && i + 2 < input.size()) {
        unsigned b; if (std::sscanf(input.substr(i + 1, 2).c_str(), "%2x", &b) == 1) {
          out += static_cast<char>(b); i += 2; continue;
        }
      }
      out += input[i];
    }
    return out;
  }
};
@WEB_NORMALIZE@
class CrossPointWebServer {
 public:
  std::unique_ptr<WebServer> server = std::make_unique<WebServer>();
  struct UploadState { String fileName, path, error; size_t size=0, bufferPos=0; bool success=false; HalFile file; };
  void handleCreateFolder() const;
  void handleRename() const;
  void handleMove() const;
  void handleDownload() const;
  void uploadBegin(UploadState& state) {
    const auto& upload = server->upload();
    unsigned long uploadStartTime=0, lastLoggedSize=0, totalWriteTime=0, writeCount=0;
    (void)uploadStartTime; (void)lastLoggedSize; (void)totalWriteTime; (void)writeCount;
@WEB_UPLOAD@
  }
};
@WEB_MKDIR@
@WEB_RENAME@
@WEB_MOVE@
@WEB_DOWNLOAD@
}
