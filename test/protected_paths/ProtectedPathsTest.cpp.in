enum { RAW_START, RAW_WRITE, RAW_END, RAW_ABORTED };
struct HTTPRaw { int status; const uint8_t* buf=nullptr; size_t currentSize=1, totalSize=1; };
class WebDAVHandler {
 public:
  String _putPath;
  bool _putOk=false, _putExisted=false;
  HalFile _putFile;
  String getRequestPath(WebServer&) const;
  String getDestinationPath(WebServer&) const;
  bool isProtectedPath(const String&) const;
  void raw(WebServer&, const String&, HTTPRaw&);
};
